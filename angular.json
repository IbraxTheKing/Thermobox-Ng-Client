{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "Thermobox-Ng-Client": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/platforms/web/styles.css"
            ],
            "define": {
              "THERMOBOX_VERSION": "\"dev\"",
              "THERMOBOX_COMMIT": "\"\""
            },
            "polyfills": [
              "@angular/localize/init"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "android": {
              "styles": [
                "src/platforms/android/styles.css"
              ],
              "fileReplacements": [
                {
                  "replace": "src/platforms/current.ts",
                  "with": "src/platforms/current.android.ts"
                }
              ]
            },
            "ios": {
              "styles": [
                "src/platforms/ios/styles.css"
              ],
              "fileReplacements": [
                {
                  "replace": "src/platforms/current.ts",
                  "with": "src/platforms/current.ios.ts"
                }
              ]
            },
            "windows": {
              "styles": [
                "src/platforms/windows/styles.css"
              ],
              "fileReplacements": [
                {
                  "replace": "src/platforms/current.ts",
                  "with": "src/platforms/current.windows.ts"
                }
              ],
              "index": "src/platforms/windows/index.html"
            },
            "macos": {
              "styles": [
                "src/platforms/macos/styles.css"
              ],
              "fileReplacements": [
                {
                  "replace": "src/platforms/current.ts",
                  "with": "src/platforms/current.macos.ts"
                }
              ]
            },
            "linux": {
              "styles": [
                "src/platforms/linux/styles.css"
              ],
              "fileReplacements": [
                {
                  "replace": "src/platforms/current.ts",
                  "with": "src/platforms/current.linux.ts"
                }
              ],
              "index": "src/platforms/linux/index.html"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "Thermobox-Ng-Client:build:production"
            },
            "development": {
              "buildTarget": "Thermobox-Ng-Client:build:development"
            },
            "android": {
              "buildTarget": "Thermobox-Ng-Client:build:development,android"
            },
            "ios": {
              "buildTarget": "Thermobox-Ng-Client:build:development,ios"
            },
            "windows": {
              "buildTarget": "Thermobox-Ng-Client:build:development,windows"
            },
            "macos": {
              "buildTarget": "Thermobox-Ng-Client:build:development,macos"
            },
            "linux": {
              "buildTarget": "Thermobox-Ng-Client:build:development,linux"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "fr",
          "baseHref": ""
        }
      }
    }
  }
}
