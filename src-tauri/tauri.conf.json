{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thermobox",
  "version": "0.0.0",
  "identifier": "ax.ibr.thermobox",
  "build": {
    "beforeDevCommand": "npm start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/Thermobox-Ng-Client/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thermobox",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "La température de chaque salle, en un coup d'œil.",
    "longDescription": "Client de bureau de ThermoBox : températures, consignes et historique des bâtiments et salles suivis par un serveur ThermoBox.",
    "copyright": "IbraxTheKing",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      },
      "rpm": {},
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}