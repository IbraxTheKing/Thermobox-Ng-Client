{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build -- --target macos",
    "beforeDevCommand": "npm start -- --configuration macos"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thermobox",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 26
        }
      }
    ]
  }
}
