{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build -- --target windows",
    "beforeDevCommand": "npm start -- --configuration windows"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thermobox",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ]
  }
}
